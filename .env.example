# Local development only. Railway variables are managed in the dashboard; see .railway/README.md.

# api
DATABASE_URL=postgres://brewbook:brewbook@localhost:5432/brewbook
Database__MigrateOnStartup=true
# GEMINI_API_KEY=               # optional: label reading + voice transcription (README → Google Cloud Console)

# web (vite dev server): where /api is proxied to, and which user the fake proxy headers claim
API_ORIGIN=http://localhost:8080
DEV_USER_EMAIL=dev@brewbook.local
