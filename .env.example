# Local development only. Railway variables are managed in the dashboard; see .railway/README.md.

# api
DATABASE_URL=postgres://brewbook:brewbook@localhost:5432/brewbook
Database__MigrateOnStartup=true
# GEMINI_API_KEY=               # optional: label reading + voice transcription (README → Google Cloud Console)
# GOOGLE_MAPS_SERVER_KEY=       # optional: roaster geocoding, Places API (New) only, no app restriction
# GOOGLE_MAPS_BROWSER_KEY=      # optional: the roaster map, Maps JavaScript API only, HTTP-referrer restricted
# GoogleMaps__RegionCode=NL     # optional: two-letter CLDR region to bias roaster search towards home
# Features__Friends=true        # off by default: friends, invitations, shared recipes, the map's friends scope
# CLOUDFLARE_EMAIL_TOKEN=       # optional: posting friend invitations (needs Features__Friends too)
# Email__AccountId=             # Cloudflare account id, needed with the token above
# Email__From=invites@your-domain            # must be on a domain onboarded for Email Sending
# Email__PublicUrl=http://localhost:3000     # where an invitation link points

# web (vite dev server): where /api is proxied to, and which user the fake proxy headers claim
API_ORIGIN=http://localhost:8080
DEV_USER_EMAIL=dev@brewbook.local
