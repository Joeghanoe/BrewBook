# Where the log lives. Production: the proxy's public origin (the only one with a domain).
EXPO_PUBLIC_API_ORIGIN=https://proxy-production-xxxx.up.railway.app

# Local only: talk to `dotnet run` directly and stamp this identity on every request, the way
# vite's dev proxy does. Leave unset against the proxy — it ignores the header anyway.
# EXPO_PUBLIC_API_ORIGIN=http://localhost:8080
# EXPO_PUBLIC_DEV_EMAIL=dev@brewbook.local
